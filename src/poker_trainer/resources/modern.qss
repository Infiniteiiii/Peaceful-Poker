/* Modern Professional Design System for Peaceful Poker */

/* ========== TYPOGRAPHY & GLOBAL ========== */
QWidget {
    background: __BG_APP__;
    color: __TEXT_PRIMARY__;
    font-family: "Inter", "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
    outline: none;
}

QMainWindow#mainWindow {
    background: __BG_APP__;
}

/* ========== HEADER ========== */
QLabel#appTitle {
    color: __TEXT_PRIMARY__;
    font-weight: 700;
    font-size: 24px;
    margin: 0px;
    padding: 8px 0px;
}

/* ========== SECTION CARDS ========== */
QGroupBox {
    background: __BG_SURFACE__;
    border: 1px solid __BORDER_SUBTLE__;
    border-radius: 12px;
    margin-top: 18px;
    padding: 18px 16px 16px 16px;
    font-weight: 600;
    font-size: 14px;
    color: __TEXT_PRIMARY__;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    top: -12px;
    padding: 0px 8px;
    background: __BG_SURFACE__;
    color: __TEXT_PRIMARY__;
    font-size: 15px;
    font-weight: 600;
}

QLabel#groupHelper {
    color: __TEXT_SECONDARY__;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.5;
}

/* ========== BUTTONS ========== */
QPushButton {
    background: __BG_SURFACE_RAISED__;
    color: __TEXT_PRIMARY__;
    border: 1px solid __BORDER_SUBTLE__;
    border-radius: 8px;
    padding: 9px 16px;
    min-height: 36px;
    font-size: 13px;
    font-weight: 500;
    transition: all 0.15s ease;
}

QPushButton:hover {
    background: __BG_SURFACE__;
    border-color: __ACCENT_HOVER__;
    color: __TEXT_PRIMARY__;
}

QPushButton:pressed {
    background: __ACCENT_PRIMARY__;
    border-color: __ACCENT_PRIMARY__;
    color: #FFFFFF;
}

QPushButton:disabled {
    color: __TEXT_DISABLED__;
    background: __BG_SURFACE__;
    border-color: __BORDER_SUBTLE__;
}

/* Primary Action Button */
QPushButton#primaryButton {
    background: __ACCENT_PRIMARY__;
    color: #FFFFFF;
    border: 1px solid __ACCENT_PRIMARY__;
    font-weight: 600;
    padding: 10px 20px;
    min-height: 40px;
    font-size: 14px;
}

QPushButton#primaryButton:hover {
    background: __ACCENT_HOVER__;
    border-color: __ACCENT_HOVER__;
}

QPushButton#primaryButton:pressed {
    background: __ACCENT_PRIMARY__;
    border-color: __ACCENT_PRIMARY__;
}

QPushButton#primaryButton:disabled {
    background: __TEXT_DISABLED__;
    border-color: __TEXT_DISABLED__;
    color: __BG_SURFACE_RAISED__;
}

/* Landing Page Button */
QPushButton#landingEnter {
    background: __ACCENT_PRIMARY__;
    color: #FFFFFF;
    border: 1px solid __ACCENT_PRIMARY__;
    border-radius: 10px;
    padding: 14px 32px;
    min-height: 44px;
    font-size: 15px;
    font-weight: 600;
}

QPushButton#landingEnter:hover {
    background: __ACCENT_HOVER__;
    border-color: __ACCENT_HOVER__;
}

/* ========== TOOL BUTTONS ========== */
QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 6px 10px;
    min-width: 32px;
    min-height: 32px;
    color: __TEXT_SECONDARY__;
    font-weight: 500;
}

QToolButton:hover {
    background: __BG_SURFACE_RAISED__;
    border-color: __BORDER_SUBTLE__;
    color: __TEXT_PRIMARY__;
}

QToolButton:pressed {
    background: __ACCENT_PRIMARY__;
    border-color: __ACCENT_PRIMARY__;
    color: #FFFFFF;
}

QToolButton#themeToggle {
    background: __BG_SURFACE_RAISED__;
    border: 1px solid __BORDER_SUBTLE__;
    border-radius: 8px;
    padding: 8px 14px;
    min-width: 90px;
    font-size: 13px;
}

/* ========== INPUTS ========== */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit {
    background: __BG_SURFACE_RAISED__;
    color: __TEXT_PRIMARY__;
    border: 1px solid __BORDER_SUBTLE__;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: __ACCENT_PRIMARY__;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid __BORDER_FOCUS__;
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    color: __TEXT_DISABLED__;
    background: __BG_SURFACE__;
}

/* Combo Box Dropdown */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid __BORDER_SUBTLE__;
    background: transparent;
}

QComboBox::down-arrow {
    image: none;
    background: none;
}

/* ========== SPIN BOX BUTTONS ========== */
QSpinBox::up-button, QDoubleSpinBox::up-button {
    width: 24px;
    height: 18px;
    subcontrol-origin: padding;
    subcontrol-position: right;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    width: 24px;
    height: 18px;
    subcontrol-origin: padding;
    subcontrol-position: right;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: none;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: none;
}

/* ========== TABS ========== */
QTabBar::tab {
    background: __BG_SURFACE_RAISED__;
    color: __TEXT_SECONDARY__;
    border: 1px solid __BORDER_SUBTLE__;
    border-radius: 10px;
    padding: 8px 16px;
    margin-right: 4px;
    font-size: 12px;
    font-weight: 500;
    transition: all 0.15s ease;
}

QTabBar::tab:hover {
    background: __BG_SURFACE__;
    color: __TEXT_PRIMARY__;
}

QTabBar::tab:selected {
    background: __ACCENT_PRIMARY__;
    color: #FFFFFF;
    border-color: __ACCENT_PRIMARY__;
}

QTabWidget::pane {
    border: 1px solid __BORDER_SUBTLE__;
    border-radius: 8px;
}

/* ========== PROGRESS BAR ========== */
QProgressBar {
    background: __BG_SURFACE_RAISED__;
    border: 1px solid __BORDER_SUBTLE__;
    border-radius: 8px;
    text-align: center;
    color: __TEXT_PRIMARY__;
    height: 24px;
    padding: 1px;
}

QProgressBar::chunk {
    background: __ACCENT_PRIMARY__;
    border-radius: 6px;
}

/* ========== STATUS LABEL ========== */
QLabel#statusPill {
    background: __BG_SURFACE_RAISED__;
    color: __TEXT_SECONDARY__;
    border: 1px solid __BORDER_SUBTLE__;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 500;
}

/* ========== TABLES ========== */
QTableWidget {
    background: __BG_SURFACE_RAISED__;
    color: __TEXT_PRIMARY__;
    border: 1px solid __BORDER_SUBTLE__;
    border-radius: 8px;
    gridline-color: __BORDER_SUBTLE__;
}

QHeaderView::section {
    background: __BG_SURFACE_RAISED__;
    color: __TEXT_SECONDARY__;
    border: none;
    border-bottom: 1px solid __BORDER_SUBTLE__;
    padding: 8px 6px;
    font-size: 12px;
    font-weight: 600;
}

QTableWidget::item {
    padding: 6px;
}

QTableWidget::item:selected {
    background: __ACCENT_PRIMARY__;
    color: #FFFFFF;
}

/* ========== SCROLL AREA ========== */
QScrollArea {
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    border: none;
}

QScrollBar::handle:vertical {
    background: __BORDER_SUBTLE__;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: __TEXT_SECONDARY__;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;
    border: none;
}

/* ========== TEXT EDIT ========== */
QTextEdit {
    background: __BG_SURFACE_RAISED__;
    color: __TEXT_PRIMARY__;
    border: 1px solid __BORDER_SUBTLE__;
    border-radius: 8px;
    padding: 8px 12px;
    font-family: "SF Mono", "Monaco", "Menlo", monospace;
    font-size: 12px;
}

QTextEdit:focus {
    border: 1px solid __BORDER_FOCUS__;
}

/* ========== LABELS ========== */
QLabel#cardLabel {
    color: __TEXT_PRIMARY__;
    font-size: 13px;
    font-weight: 500;
    min-width: 110px;
}

QLabel#landingTitle {
    font-size: 32px;
    font-weight: 700;
    color: __TEXT_PRIMARY__;
}

/* ========== DIALOGS ========== */
QDialog {
    background: __BG_APP__;
}

QDialogButtonBox {
    background: transparent;
    border: none;
}
