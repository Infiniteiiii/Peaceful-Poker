QWidget {
    background: __BG_APP__;
    color: __TEXT_PRIMARY__;
    font-family: "Inter", "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}
QMainWindow#mainWindow {
    background: __BG_APP__;
}
QGroupBox,
QWidget#panelCard {
    background: __BG_SURFACE__;
    border: 1px solid __BORDER_SUBTLE__;
    border-radius: 14px;
}
QGroupBox {
    margin-top: 14px;
    padding: 16px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    /* reduce negative offset so titles aren't cropped */
    top: -6px;
    padding: 0 4px;
}
QLabel#groupHelper {
    color: __TEXT_SECONDARY__;
    font-size: 12px;
}
QLabel#appTitle {
    color: __TEXT_PRIMARY__;
    font-weight: 700;
    font-size: 18px;
}
QPushButton {
    background: __BG_SURFACE_RAISED__;
    color: __TEXT_PRIMARY__;
    border: 1px solid __BORDER_SUBTLE__;
    border-radius: 10px;
    padding: 8px 12px;
    min-height: 36px;
}
QPushButton:hover {
    background: __BG_SURFACE__;
    border-color: __ACCENT_SECONDARY__;
}
QPushButton:pressed {
    background: __BG_SURFACE_RAISED__;
}
QPushButton:disabled {
    color: __TEXT_DISABLED__;
    background: __BG_SURFACE__;
    border-color: __BORDER_SUBTLE__;
}
QPushButton#primaryButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 __ACCENT_PRIMARY__, stop:1 __ACCENT_SECONDARY__);
    color: __TEXT_PRIMARY__;
    border-color: rgba(255,255,255,0.06);
    font-weight: 700;
}
QToolButton#themeToggle {
    background: __BG_SURFACE__;
    border: 1px solid __BORDER_SUBTLE__;
    border-radius: 10px;
    padding: 8px 14px;
    min-width: 90px;
}
QToolButton {
    min-width: 28px;
    min-height: 28px;
    border-radius: 16px;
    padding: 4px 8px;
}
QToolButton:pressed {
    background: rgba(255,255,255,0.08);
}
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QTableWidget {
    background: __BG_SURFACE_RAISED__;
    color: __TEXT_PRIMARY__;
    border: 1px solid __BORDER_SUBTLE__;
    border-radius: 10px;
    padding: 8px;
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    color: __TEXT_DISABLED__;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px;
    border-left: 1px solid __BORDER_SUBTLE__;
}
QComboBox::down-arrow {
    image: none;
    border: none;
    width: 0;
    height: 0;
    margin: 0;
}
QScrollArea {
    background: transparent;
}
QProgressBar {
    border: 1px solid __BORDER_SUBTLE__;
    border-radius: 10px;
    text-align: center;
    background: __BG_SURFACE_RAISED__;
    color: __TEXT_PRIMARY__;
}
QProgressBar::chunk {
    background: __ACCENT_PRIMARY__;
    border-radius: 10px;
}
QTabBar::tab {
    background: __BG_SURFACE_RAISED__;
    color: __TEXT_SECONDARY__;
    border: 1px solid __BORDER_SUBTLE__;
    border-radius: 12px;
    padding: 10px 14px;
    margin: 0 4px;
}
QTabBar::tab:selected {
    background: __ACCENT_PRIMARY__;
    color: #08110a;
    border-color: __ACCENT_PRIMARY__;
}
QHeaderView::section {
    background: __BG_SURFACE__;
    color: __TEXT_SECONDARY__;
    border: 1px solid __BORDER_SUBTLE__;
    padding: 6px;
}
QTableWidget {
    gridline-color: __BORDER_SUBTLE__;
}

/* Glassmorphic enhancements */
QWidget#panelCard, QGroupBox, QFrame {
    background: rgba(14,24,45,0.72);
    border: 1px solid rgba(255,255,255,0.04);
    border-radius: 16px;
}

QGroupBox::title {
    background: rgba(255,255,255,0.02);
    padding: 6px 10px;
    border-radius: 10px;
}

QPushButton {
    background: rgba(255,255,255,0.03);
    color: __TEXT_PRIMARY__;
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 14px;
    padding: 8px 14px;
    min-height: 40px;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QTableWidget {
    background: rgba(255,255,255,0.02);
    color: __TEXT_PRIMARY__;
    border: 1px solid rgba(255,255,255,0.04);
    border-radius: 12px;
    padding: 8px;
}

QLabel#appTitle {
    font-size: 20px;
    font-weight: 700;
}

QLabel#cardLabel {
    color: __TEXT_PRIMARY__;
    padding-right: 8px;
    font-weight: 600;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 __ACCENT_PRIMARY__, stop:1 __ACCENT_SECONDARY__);
}

/* Back button in header */
QPushButton#headerBack {
    background: rgba(255,255,255,0.04);
    color: __TEXT_SECONDARY__;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    padding: 4px 12px;
    min-height: 28px;
    font-size: 12px;
}
QPushButton#headerBack:hover {
    color: __TEXT_PRIMARY__;
    border-color: __ACCENT_PRIMARY__;
}

/* ========== LANDING PAGE ========== */
QWidget#landingPage {
    background: __BG_APP__;
}

QWidget#landingHero {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #080E1E, stop:0.6 #0B1223, stop:1 __BG_APP__);
    border-bottom: 1px solid __BORDER_SUBTLE__;
}

QLabel#landingSuits {
    color: __ACCENT_PRIMARY__;
    font-size: 34px;
    letter-spacing: 8px;
}

QLabel#landingTitle {
    color: __TEXT_PRIMARY__;
    font-size: 48px;
    font-weight: 800;
    letter-spacing: -1px;
}

QLabel#landingSubtitle {
    color: __TEXT_SECONDARY__;
    font-size: 16px;
    font-weight: 400;
}

QPushButton#landingEnter {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 __ACCENT_PRIMARY__, stop:1 __ACCENT_SECONDARY__);
    color: #FFFFFF;
    border: none;
    border-radius: 14px;
    font-size: 16px;
    font-weight: 700;
    padding: 0 28px;
}
QPushButton#landingEnter:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 __ACCENT_HOVER__, stop:1 __ACCENT_PRIMARY__);
}
QPushButton#landingEnter:pressed {
    background: __ACCENT_PRIMARY__;
}

QFrame#landingDivider {
    background: __BORDER_SUBTLE__;
    border: none;
}

QWidget#landingFeatures {
    background: __BG_SURFACE__;
}

QFrame#featureCard {
    background: __BG_SURFACE_RAISED__;
    border: 1px solid __BORDER_SUBTLE__;
    border-radius: 14px;
}

QLabel#featureIcon {
    font-size: 28px;
}

QLabel#featureTitle {
    color: __TEXT_PRIMARY__;
    font-size: 14px;
    font-weight: 700;
}

QLabel#featureBody {
    color: __TEXT_SECONDARY__;
    font-size: 12px;
}

