QWidget {
    background: __BG_APP__;
    color: __TEXT_PRIMARY__;
}
QMainWindow#mainWindow {
    background: __BG_APP__;
}
QFrame#sidebar,
QGroupBox,
QWidget#panelCard {
    background: __BG_SURFACE__;
    border: 1px solid __BORDER_SUBTLE__;
    border-radius: 14px;
}
QGroupBox {
    margin-top: 14px;
    padding: 16px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    /* reduce negative offset so titles aren't cropped */
    top: -6px;
    padding: 0 4px;
}
QLabel#groupHelper,
QLabel#sidebarFooter,
QLabel#sidebarLabel {
    color: __TEXT_SECONDARY__;
    font-size: 12px;
}
QLabel#appTitle {
    color: __TEXT_PRIMARY__;
    font-weight: 700;
    font-size: 18px;
}
QWidget#sidebar {
    background: __BG_SURFACE__;
}
QLabel#sidebarLogo {
    font-size: 32px;
    font-weight: 700;
    color: __ACCENT_PRIMARY__;
}
QPushButton {
    background: __BG_SURFACE_RAISED__;
    color: __TEXT_PRIMARY__;
    border: 1px solid __BORDER_SUBTLE__;
    border-radius: 10px;
    padding: 8px 12px;
    min-height: 36px;
}
QPushButton:hover {
    background: __BG_SURFACE__;
    border-color: __ACCENT_SECONDARY__;
}
QPushButton:pressed {
    background: __BG_SURFACE_RAISED__;
    transform: scale(0.99);
}
QPushButton:disabled {
    color: __TEXT_DISABLED__;
    background: __BG_SURFACE__;
    border-color: __BORDER_SUBTLE__;
}
QPushButton#primaryButton {
    background: __ACCENT_PRIMARY__;
    color: #08110a;
    border-color: __ACCENT_PRIMARY__;
    font-weight: 700;
}
QPushButton#sidebarNav {
    text-align: left;
}
QToolButton#themeToggle {
    background: __BG_SURFACE__;
    border: 1px solid __BORDER_SUBTLE__;
    border-radius: 10px;
    padding: 6px 12px;
}
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QTableWidget {
    background: __BG_SURFACE_RAISED__;
    color: __TEXT_PRIMARY__;
    border: 1px solid __BORDER_SUBTLE__;
    border-radius: 10px;
    padding: 8px;
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    color: __TEXT_DISABLED__;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px;
    border-left: 1px solid __BORDER_SUBTLE__;
}
QComboBox::down-arrow {
    image: none;
    border: none;
    width: 0;
    height: 0;
    margin: 0;
}
QScrollArea {
    background: transparent;
}
QProgressBar {
    border: 1px solid __BORDER_SUBTLE__;
    border-radius: 10px;
    text-align: center;
    background: __BG_SURFACE_RAISED__;
    color: __TEXT_PRIMARY__;
}
QProgressBar::chunk {
    background: __ACCENT_PRIMARY__;
    border-radius: 10px;
}
QTabBar::tab {
    background: __BG_SURFACE_RAISED__;
    color: __TEXT_SECONDARY__;
    border: 1px solid __BORDER_SUBTLE__;
    border-radius: 12px;
    padding: 10px 14px;
    margin: 0 4px;
}
QTabBar::tab:selected {
    background: __ACCENT_PRIMARY__;
    color: #08110a;
    border-color: __ACCENT_PRIMARY__;
}
QHeaderView::section {
    background: __BG_SURFACE__;
    color: __TEXT_SECONDARY__;
    border: 1px solid __BORDER_SUBTLE__;
    padding: 6px;
}
QTableWidget {
    gridline-color: __BORDER_SUBTLE__;
}

/* Glass-like surfaces for light theme */
QFrame#sidebar {
    background: __BG_SURFACE__;
    border: 1px solid rgba(16,24,35,0.04);
    border-radius: 20px;
    padding: 12px;
}

QWidget#panelCard, QGroupBox, QFrame {
    background: __BG_SURFACE__;
    border: 1px solid rgba(16,24,35,0.04);
    border-radius: 16px;
}

QGroupBox::title {
    background: rgba(0,0,0,0.02);
    padding: 6px 10px;
    border-radius: 10px;
}

QPushButton {
    background: rgba(0,0,0,0.03);
    color: __TEXT_PRIMARY__;
    border: 1px solid rgba(16,24,35,0.06);
    border-radius: 14px;
    padding: 8px 14px;
    min-height: 40px;
}

QPushButton#sidebarNav {
    text-align: left;
    padding-left: 12px;
    border-radius: 12px;
}

QToolButton#menuToggle, QToolButton#backToLanding, QToolButton#themeToggle {
    background: rgba(0,0,0,0.02);
    border: 1px solid rgba(16,24,35,0.04);
    border-radius: 12px;
    padding: 6px 10px;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QTableWidget {
    background: __BG_SURFACE_RAISED__;
    color: __TEXT_PRIMARY__;
    border: 1px solid rgba(16,24,35,0.04);
    border-radius: 12px;
    padding: 8px;
}

QLabel#cardLabel {
    color: __TEXT_PRIMARY__;
    padding-right: 8px;
    font-weight: 600;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 __ACCENT_PRIMARY__, stop:1 __ACCENT_SECONDARY__);
}
